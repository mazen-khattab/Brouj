<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="(@request_ProjectId uniqueidentifier,@p int,@p2 int)SELECT [b0].[Id], [b0].[ProjectId], [b0].[Number], [b0].[MeterPrice], [b0].[FloorNumber], [b0].[Size], CEILING([b0].[Size] * [b0].[MeterPrice] * 100.0) / 100.0 AS [TotalPrice], [i].[NeighborMeterPrice], [i].[Percentage], CASE&#x0D;&#x0A;    WHEN NOT EXISTS (&#x0D;&#x0A;        SELECT 1&#x0D;&#x0A;        FROM [Reservations] AS [r]&#x0D;&#x0A;        LEFT JOIN [Orders] AS [o] ON [r].[Id] = [o].[ReservationId]&#x0D;&#x0A;        WHERE [b0].[Id] = [r].[UnitId] AND [o].[Id] IS NOT NULL AND ([o].[Status] &lt;&gt; 'pending' OR [o].[Status] IS NULL)) THEN CAST(1 AS bit)&#x0D;&#x0A;    ELSE CAST(0 AS bit)&#x0D;&#x0A;END AS [IsAvailable]&#x0D;&#x0A;FROM (&#x0D;&#x0A;    SELECT [b].[Id], [b].[FloorNumber], [b].[MeterPrice], [b].[Number], [b].[ProjectId], [b].[Size]&#x0D;&#x0A;    FROM [BaseUnits] AS [b]&#x0D;&#x0A;    WHERE [b].[ProjectId] = @request_ProjectId&#x0D;&#x0A;    ORDER BY [b].[Number], [b].[Id]&#x0D;&#x0A;    OFFSET @p ROWS FETCH NEXT @p2 ROWS ONLY&#x0D;&#x0A;) AS [b0]&#x0D;&#x0A;LEFT JOIN [InitiativeUnits] AS [i] ON [b0].[Id] = [i].[UnitId]&#x0D;&#x0A;ORDER BY [b0].[Number], [b0].[Id]" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090007363F7D77333D962B491B20A57F8F0E0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="0.363155" StatementEstRows="15.4415" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x5FD036F4FD9F22D4" QueryPlanHash="0x73D828C13D8DB713" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" A